# Leaderboard (api/*.ts). Copy to .env for `npm run dev`; on Vercel set
# them in Project Settings → Environment Variables (the Vercel ↔ Neon
# integration can set DATABASE_URL, with a Neon branch per preview deploy).
# Vercel runs the pending database migrations before each Production and
# Preview build (`vercel-build`, scripts/db/vercel-migrate.mjs); set
# SKIP_DB_MIGRATE=1 for an environment that must not be migrated by deploys.

# Neon Postgres connection string (the pooled one). Then run `npm run db:migrate`
# to create / update the tables. Keep the quotes: Neon URLs contain `&`, which
# cuts the value short if this file is ever `source`d in a shell.
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Signs run tokens and hashes addresses: 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LEADERBOARD_SECRET=

# TypeSafe API key (https://console.typesafe.ai/keys) for the nickname filter's
# second layer: Jev judges names the word list can't (api/_lib/nameFilter.ts).
# Optional: without it only the word list applies. Server-side only: never
# expose it to the browser bundle.
TYPESAFE_API_KEY=

# Draw the airspace edge as a dashed outline (src/config.ts). Debugging only; the VITE_ prefix is what lets Vite expose it to the browser.
VITE_DEBUG_SHOW_AIRSPACE=false
