# Leaderboard (api/*.ts). Copy to .env for `npm run dev`; on Vercel set
# them in Project Settings → Environment Variables (the Vercel ↔ Neon
# integration can set DATABASE_URL, with a Neon branch per preview deploy).

# Neon Postgres connection string (the pooled one). Apply db/schema.sql once.
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Signs run tokens and hashes addresses: 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LEADERBOARD_SECRET=

# TypeSafe API key for @typesafe-ai/sdk (from https://console.typesafe.ai/keys).
# Server-side only: use it from api/, never expose it to the browser bundle.
TYPESAFE_API_KEY=
